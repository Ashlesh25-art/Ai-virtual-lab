# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/aivirtuallab"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=4000
FRONTEND_URL="http://localhost:3000"

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# ─── Judge0 ───────────────────────────────────────────────────────────────────
JUDGE0_URL="http://localhost:2358"
JUDGE0_AUTH_TOKEN=""

# ─── AI Services ──────────────────────────────────────────────────────────────
GROQ_API_KEY="your-groq-api-key"
HINT_SERVICE_URL="http://localhost:8001"
ERROR_EXPLANATION_SERVICE_URL="http://localhost:8002"
VIVA_SERVICE_URL="http://localhost:8003"
RECOMMENDATION_SERVICE_URL="http://localhost:8004"
KNOWLEDGE_TRACING_SERVICE_URL="http://localhost:8005"
ANALYTICS_SERVICE_URL="http://localhost:8006"
PREDICTION_SERVICE_URL="http://localhost:8007"

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── File Storage ─────────────────────────────────────────────────────────────
STORAGE_PATH="./uploads"
MAX_FILE_SIZE_MB=50
